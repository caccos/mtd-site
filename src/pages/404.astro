---
import Base from "../layouts/Base.astro";
---

<Base
  title="Página não encontrada · Mind The Digital"
  description="Esta página não existe no site da Mind The Digital."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Não encontramos esta página</h1>
      <p class="lede">O endereço pode ter mudado. Volte para a home ou fale com o estúdio.</p>
      <div class="actions">
        <a class="btn btn-rust" href="/">Ir para a home</a>
        <a class="btn btn-ghost" href="/contato">Contato</a>
      </div>
    </div>
  </section>
</Base>
