---
import { catalogThemes } from "../data/catalog";
---

<section class="band" id="temas" aria-labelledby="temas-titulo">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">Catálogo</p>
      <h2 id="temas-titulo">Temas que estamos construindo</h2>
      <p class="section-lede">
        Seis pontos de partida para sites de clientes. Cada cartão mostra a marca de
        exemplo, o que o tema cobre e os módulos. A prévia fica aqui até existir um
        endereço público.
      </p>
    </header>
    <div class="catalog-grid">
      {
        catalogThemes.map((theme) => (
          <article class="theme" style={`--accent:${theme.accent}`}>
            <div class="theme-media">
              <img
                src={theme.thumb}
                width="1440"
                height="900"
                alt={`Prévia do tema ${theme.brand}`}
              />
              <p class="theme-status">
                Prévia
                <span class="sr-only"> — endereço público ainda não publicado</span>
              </p>
            </div>
            <div class="theme-body">
              <p class="theme-brand">{theme.brand}</p>
              <h3>{theme.title}</h3>
              <p>{theme.excerpt}</p>
              <ul class="modules" aria-label="Módulos">
                {theme.modules.map((module) => (
                  <li>{module}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
